# Copy this file to .env.local and fill in your key.
# Only needed for the AI Trade Assistant; everything else works without it.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: which Claude model the assistant uses (default: claude-opus-5-5).
# claude-sonnet-5-5 is about half the price per token.
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional: "Sign in with Yahoo" (lets people import Yahoo leagues).
# Create an app at https://developer.yahoo.com/apps/create/ — see README → Yahoo sign-in.
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# Any long random string; encrypts the Yahoo sign-in cookie. e.g. run: openssl rand -base64 32
# SESSION_SECRET=
