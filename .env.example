# Copy this file to .env.local. Everything here is optional: the site works without any of it.

# Optional: "Sign in with Yahoo" (lets people import Yahoo leagues).
# Create an app at https://developer.yahoo.com/apps/create/ — see README → Yahoo sign-in.
# YAHOO_CLIENT_ID=
# YAHOO_CLIENT_SECRET=
# Any long random string; encrypts the Yahoo sign-in cookie. e.g. run: openssl rand -base64 32
# SESSION_SECRET=

# Optional: "Sign in with Google" so people can save their team to an account.
# Google Cloud Console → Google Auth Platform → Clients → Web application,
# redirect URI https://YOUR-SITE.vercel.app/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# (also needs SESSION_SECRET above)

# Saved-teams database: Vercel → Storage → Upstash for Redis (free). Vercel adds these for you.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
